# 네이버 클라우드 플랫폼 Maps > Web Dynamic Map 키
# Client Secret은 서버에만 두고, 브라우저에는 Client ID만 전달합니다.
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=

# Google AI Studio 이미지 생성 키 (https://aistudio.google.com/apikey)
# 지금 보이는 거리뷰 화면을 밤 장면으로 바꿀 때 사용합니다. 원본은 저장하지 않습니다.
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_IMAGE_SIZE=2K
