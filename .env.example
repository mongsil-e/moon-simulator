# 네이버 클라우드 플랫폼 Maps > Web Dynamic Map 키
# Client Secret은 서버에만 두고, 브라우저에는 Client ID만 전달합니다.
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=

# Google AI Studio 이미지 생성 키 (https://aistudio.google.com/apikey)
# 브라우저에 보이는 거리뷰 영역을 밤 장면으로 바꿀 때 사용합니다. 원본 캡처는 저장하지 않습니다.
GEMINI_API_KEY=
# 기본 모델은 Nano Banana 2 (gemini-3.1-flash-image).
# 더 정밀한 편집이 필요하면 Nano Banana Pro: gemini-3-pro-image
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_IMAGE_SIZE=1K
